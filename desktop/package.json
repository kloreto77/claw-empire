{
  "name": "mesa-operacoes-desktop",
  "version": "2.0.7",
  "private": true,
  "main": "main.cjs",
  "description": "Mesa de Operações V2 para Windows",
  "author": "KMS",
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "br.kms.mesaoperacoes",
    "productName": "Mesa de Operações V2",
    "executableName": "MesaOperacoesV2",
    "asar": true,
    "files": [
      "main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "../desktop-release"
    },
    "extraResources": [
      {
        "from": "../.desktop-runtime",
        "to": "mesa-runtime",
        "filter": [
          "**/*",
          "!node_modules",
          "!node_modules/**"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "Mesa-V2-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kloreto77",
        "repo": "claw-empire",
        "releaseType": "release"
      }
    ],
    "afterPack": "./after-pack.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
